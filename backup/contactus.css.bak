/* =========================================================
   OVERRIDE DOCUMENT ABSOLUTE FLOW BLOCKS (PREVENTS OVERLAPS)
========================================================= */
section, 
.subpage-main, 
.contact-main-container,
.contact-workspace-grid,
.dispatch-form-card,
.campus-gps-card {
    position: relative !important;
    top: auto !important;
    left: auto !important;
    transform: none !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    display: flex !important;
    flex-direction: column !important;
    box-sizing: border-box !important;
}

/* =========================================================
   MAIN CORE VIEWPORT CONFIGURATIONS
========================================================= */
.contact-main-container {
    padding-top: 120px !important; /* CLEARS COGNITIVE NAVIGATION OVERLAYS */
    padding-bottom: 60px !important;
    max-width: 1240px !important;
    margin: 0 auto !important;
    align-items: center !important;
}

.contact-hero-header {
    text-align: center !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 auto 36px auto !important;
    width: 100% !important;
    max-width: 800px !important;
    padding: 0 20px !important;
}

/* =========================================================
   DIRECT FUNCTIONAL HEADS (CHIPS LIST SEGMENT)
========================================================= */
.team-leads-section {
    width: 94% !important;
    max-width: 1200px !important;
    margin: 0 auto 40px auto !important;
}

.team-cards-grid {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(220px, 1fr)) !important;
    gap: 20px !important;
    width: 100% !important;
}

.team-lead-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    text-align: center !important;
    padding: 24px 20px !important;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3) !important;
}

.lead-avatar {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    flex-shrink: 0 !important;
}

.lead-details {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 6px !important;
    width: 100% !important;
}

/* =========================================================
   WORKSPACE SYMETRICAL BLOCKS DEPLOYMENT
========================================================= */
.contact-workspace-grid {
    display: grid !important;
    grid-template-columns: 1fr 380px !important; /* SYMMETRIC TWO-COLUMN SIDEBAR SPLIT */
    gap: 28px !important;
    width: 94% !important;
    max-width: 1200px !important;
    margin: 0 auto 50px auto !important;
    align-items: start !important;
}

.dispatch-form-card {
    padding: 32px !important;
    box-shadow: 0 14px 45px rgba(0, 0, 0, 0.55) !important;
}

.dispatch-signal-lbl {
    display: flex !important;
    align-items: center !important;
    gap: 8px !important;
    margin-bottom: 24px !important;
}

/* =========================================================
   DYNAMIC INPUT GRID FORM FIELDS
========================================================= */
.proposal-form {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 20px 16px !important;
    width: 100% !important;
}

.full-width {
    grid-column: 1 / -1 !important;
}

.input-field {
    display: flex !important;
    flex-direction: column !important;
    gap: 6px !important;
}

.input-field input,
.input-field select,
.input-field textarea {
    width: 100% !important;
    box-sizing: border-box !important;
}

.input-field textarea {
    min-height: 120px !important;
}

.form-submit-bar {
    grid-column: 1 / -1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
    margin-top: 8px !important;
    padding-top: 20px !important;
    border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
}

/* =========================================================
   CAMPUS TELEMETRY RIGHT PANEL SIDEBAR
========================================================= */
.campus-gps-card {
    padding: 28px !important;
    gap: 24px !important;
    box-shadow: 0 14px 45px rgba(0, 0, 0, 0.55) !important;
}

.gps-coords-box {
    padding: 20px 16px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
}

.transport-routes-list {
    display: flex !important;
    flex-direction: column !important;
    gap: 12px !important;
    width: 100% !important;
}

.route-item {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 14px !important;
    width: 100% !important;
}

.r-info {
    display: flex !important;
    flex-direction: column !important;
    gap: 2px !important;
}

.gmaps-nav-btn {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    padding: 14px !important;
    box-shadow: 0 0 15px rgba(0, 242, 254, 0.3) !important;
}

/* =========================================================
   RESPONSIVE DESIGN SYSTEM BREAKPOINTS
========================================================= */
@media (max-width: 1100px) {
    .team-cards-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}

@media (max-width: 1024px) {
    .contact-workspace-grid {
        grid-template-columns: 1fr !important; /* FLATTENS CONTAINER INTO ONE STREAM FOR HOVER BLOCKS */
        gap: 28px !important;
    }
    
    .campus-gps-card {
        width: 100% !important;
    }
}

@media (max-width: 650px) {
    .team-cards-grid,
    .proposal-form {
        grid-template-columns: 1fr !important; /* COMPRESSED STREAM FOR SMARTPHONE MOBILE RESOLUTIONS */
    }

    .contact-main-container {
        padding-top: 100px !important;
    }

    .dispatch-form-card {
        padding: 20px !important;
    }
}
